# Copy to .env - NEVER commit the real file.
# On the server this lives in the release's shared/ directory and is symlinked into
# every release, so it survives deploys.

APP_ENV=production
APP_TZ=Europe/Budapest

DB_HOST=localhost
DB_NAME=__CPANEL_USER___app
DB_USER=__CPANEL_USER___app
DB_PASS=

# SMTP - shared-hosting mail() lands in spam, authenticate as a real mailbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
