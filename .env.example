# Copy to .env in this toolkit root. Gitignored. This is the ONLY place secrets live -
# config/sites.json records the NAME of each variable, never its value.

# cPanel API token: cPanel > Security > Manage API Tokens. Not the account password.
# The name must match defaults.cpanel.apiTokenEnv (or a site's own cpanel.apiTokenEnv).
CPANEL_TOKEN_MAIN=

# Database passwords, named by each site's database.passwordEnv
DB_PASS_DEMO=
DB_PASS_DEMO_STG=

# Optional: GitHub PAT if you prefer a token to the OAuth flow that /mcp offers.
# GITHUB_TOKEN=
